<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net6.0;net8.0;netstandard2.1</TargetFrameworks>
	<Version>1.0.2</Version>
    <Authors>dmitrii-tolstov</Authors>
    <Description>Write serilog events to clickhouse database.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dmitrii-tolstov/Serilog.Sinks.ClickHouse</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageTags>serilog, clickhouse</PackageTags>
    <PackageProjectUrl>https://github.com/dmitrii-tolstov/Serilog.Sinks.ClickHouse</PackageProjectUrl>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © Dmitry Tolstov 2026</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Ado" Version="2.0.5" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
	
</Project>